
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voice_bots

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

PUBLIC_BACKEND_URL=

SARVAM_API_KEY=


ATTENDEE_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MEETING_BOT_EMAIL=

MEETING_TOKEN_KEY=

MEETING_OPERATOR_USER_IDS=[]


CLINIC_OPERATOR_USER_IDS=[]

# Backend only. Domain format: your-app.metered.live (without https://).
METERED_DOMAIN=
METERED_SECRET_KEY=


# Twilio Programmable Voice credentials and calling number
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Launch controls. Production validates HTTPS origins, PostgreSQL and JWT_SECRET.
APP_ENVIRONMENT=development
REGISTRATION_ENABLED=true
# Keep the existing demo experience available in every environment.
DEMO_ENABLED=true
AUTH_MAX_CONCURRENCY=4

# Token buckets: capacity refills evenly over the named minute/hour.
API_REQUESTS_PER_MINUTE=2400
USER_REQUESTS_PER_MINUTE=1200
LOGIN_REQUESTS_PER_MINUTE=10
SIGNUP_REQUESTS_PER_HOUR=5
DEMO_REQUESTS_PER_HOUR=3
WRITE_REQUESTS_PER_MINUTE=120
VOICE_STARTS_PER_MINUTE=10
PHONE_CALLS_PER_MINUTE=10
CAMPAIGN_STARTS_PER_MINUTE=3
VOICE_TOKENS_PER_MINUTE=60
RATE_LIMIT_MAX_BUCKETS=20000
MAX_REQUEST_BODY_BYTES=3000000
REQUEST_BODY_TIMEOUT_SECONDS=30

# Uvicorn proxy trust: use only your actual reverse-proxy IPs/networks.
# Never set '*' unless the app is isolated behind a proxy that strips spoofed headers.
FORWARDED_ALLOW_IPS=127.0.0.1
